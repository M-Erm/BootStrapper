<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:BootStrapper.ViewModels"
             x:Class="BootStrapper.Views.SidebarView"
             x:DataType="vm:SidebarViewModel">

    <UserControl.Styles>

        <Style Selector="Button.sidebar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style Selector="Button.sidebar:pointerover">
            <Setter Property="Background" Value="#2D2D2D"/>
        </Style>

        <Style Selector="TextBlock.icon">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.menuText">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border#SidebarBorder:pointerover TextBlock.menuText">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

    </UserControl.Styles>

    <Border x:Name="SidebarBorder"
            Width="65"
            Background="#2B2D3D"
            HorizontalAlignment="Left">

        <Border.Styles>
            <Style Selector="Border#SidebarBorder:pointerover">
                <Setter Property="Width" Value="220"/>
            </Style>
        </Border.Styles>

        <Grid Margin="10" RowDefinitions="Auto,*,Auto">

            <StackPanel Grid.Row="0" Spacing="8">
                <Button Classes="sidebar" Command="{Binding GoToHomeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="⌂"/>
                        <TextBlock Classes="menuText" Text="Home"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center">
                <Button Classes="sidebar" Command="{Binding GoToProjectCreateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="＋"/>
                        <TextBlock Classes="menuText" Text="Create Project"/>
                    </StackPanel>
                </Button>

                <Button Classes="sidebar" Command="{Binding GoToTemplateListCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="▦"/>
                        <TextBlock Classes="menuText" Text="Template List"/>
                    </StackPanel>
                </Button>

                <Button Classes="sidebar" Command="{Binding GoToProjectListCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="▣"/>
                        <TextBlock Classes="menuText" Text="Project List"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Row="2" Classes="sidebar" Command="{Binding GoToCreditsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="icon" Text="ⓘ"/>
                    <TextBlock Classes="menuText" Text="Credits"/>
                </StackPanel>
            </Button>

        </Grid>
    </Border>

</UserControl>