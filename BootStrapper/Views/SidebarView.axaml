<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:BootStrapper.ViewModels"
             x:Class="BootStrapper.Views.SidebarView"
             x:DataType="vm:SidebarViewModel"
             Width="65">

    <UserControl.Styles>

        <Style Selector="Button.sidebar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style Selector="TextBlock.icon">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.menuText">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector=":is(UserControl).expanded TextBlock.menuText">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

    </UserControl.Styles>

    <Border x:Name="SidebarBorder" Background="#2B2D3D" HorizontalAlignment="Stretch">

        <Grid Margin="10" RowDefinitions="Auto,*,Auto">

            <StackPanel Grid.Row="0" Spacing="8">

                <Button Classes="sidebar" Command="{Binding GoToHomeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="⌂"/>
                        <TextBlock Classes="menuText" VerticalAlignment="Center" Text="Home"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center">

                <Button Classes="sidebar" Command="{Binding GoToProjectCreateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="＋"/>
                        <TextBlock Classes="menuText" VerticalAlignment="Center" Text="Create Project"/>
                    </StackPanel>
                </Button>

                <Button Classes="sidebar" Command="{Binding GoToProjectListCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="▣"/>
                        <TextBlock Classes="menuText" VerticalAlignment="Center" Text="Project List"/>
                    </StackPanel>
                </Button>

                <Button Classes="sidebar" Command="{Binding GoToTemplateListCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="▦"/>
                        <TextBlock Classes="menuText" VerticalAlignment="Center" Text="Template List"/>
                    </StackPanel>
                </Button>

                <Button Classes="sidebar" Command="{Binding GoToOfficialTemplatesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="🌐"/>
                        <TextBlock Classes="menuText" VerticalAlignment="Center" Text="Official Templates"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <StackPanel Grid.Row="2">

                <Button Classes="sidebar" Command="{Binding GoToCreditsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="ⓘ"/>
                        <TextBlock Classes="menuText" VerticalAlignment="Center" Text="Credits"/>
                    </StackPanel>
                </Button> 
            
                <Button Classes="sidebar" Command="{Binding GoToSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="⚙️"/>
                        <TextBlock Classes="menuText" VerticalAlignment="Center" Text="Settings"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>
    </Border>

</UserControl>