<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BootStrapper.ViewModels"
        xmlns:view="using:BootStrapper.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BootStrapper.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        RequestedThemeVariant="Dark"
        Icon="/Assets/avalonia-logo.ico"
        Title="BootStrapper"
        Width="1280" Height="690">

    <Grid ColumnDefinitions="Auto,*" Background="#171717">
        <view:SidebarView Grid.Column="0" DataContext="{Binding Sidebar}"/>
        <ContentControl Grid.Column="1" Content="{Binding Navigation.CurrentView}" />
    </Grid>
</Window>