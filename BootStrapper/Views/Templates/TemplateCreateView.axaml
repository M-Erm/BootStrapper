<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:templates="using:BootStrapper.ViewModels.Templates"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:BootStrapper.ViewModels.Templates"
             x:Class="BootStrapper.Views.Templates.TemplateCreate"
             x:DataType="vm:TemplateCreateViewModel">

    <Design.DataContext>
        <vm:TemplateCreateViewModel></vm:TemplateCreateViewModel>
    </Design.DataContext>

    <Grid>
        <TextBlock Text="{Binding TemplateCreateMainTEXT}" />
    </Grid>

</UserControl>
