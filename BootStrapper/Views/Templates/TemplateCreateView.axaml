<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Height="600"
             xmlns:models="clr-namespace:BootStrapper.Core.Models;assembly=BootStrapper.Core"
             xmlns:vm="clr-namespace:BootStrapper.ViewModels.Templates"
             x:Class="BootStrapper.Views.Templates.TemplateCreateView"
             x:DataType="vm:TemplateCreateViewModel">

    <Design.DataContext>
        <vm:TemplateCreateViewModel/>
    </Design.DataContext>

    <Grid Background="#171717">

        <Border Width="620"
                Height="450"
                Padding="24"
                CornerRadius="12"
                Background="#37345D"
                BorderBrush="White"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid RowDefinitions="Auto,*,Auto" MinHeight="400" ColumnDefinitions="*,*" RowSpacing="18" ColumnSpacing="50">

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="6">
                    <TextBlock Text="Create Template" FontSize="24" Foreground="White"/>
                    <TextBlock Text="Insert the new template infos and the basic file structure" FontSize="14" Foreground="#D6D6D6"/>
                </StackPanel>

                <!--LEFT SIDE-->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="12">

                    <TextBlock Text="Template Name" Foreground="White"/>
                    <TextBox Text="{Binding Name}" PlaceholderText="Template name" />

                    <TextBlock Text="Template Description" Foreground="White"/>
                    <TextBox Text="{Binding Description}" PlaceholderText="Template description"
                             AcceptsReturn="True"
                             Height="65" />

                    <TextBlock Text="Tags" Foreground="White"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding Tags}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#6CCC"
                                            CornerRadius="5"
                                            Margin="4"
                                            Padding="8,4">
                                        <TextBlock Text="{Binding .}" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>

                    <TextBlock Text="Template Author" Foreground="White"/>
                    <TextBox Text="{Binding Author}" PlaceholderText="Template Author" AcceptsReturn="True"/>

                </StackPanel>

                <!--RIGHT SIDE -->
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="10">

                    <TextBlock Text="Unity Version" Foreground="White"/>
                    <TextBox Text="{Binding UnityVersion}" PlaceholderText="Unity version"/>

                    <TextBlock Text="Scripts Preview" Foreground="White"/>

                    <Border Height="150" Background="#6fff" CornerRadius="8" Padding="12">

                        <TreeView ItemsSource="{Binding TemplateScripts}" Foreground="Wheat" SelectedItem="{Binding }">
                            <TreeView.ItemTemplate>

                                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:TemplateNode">

                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="📁" IsVisible="{Binding IsFolder}" />
                                        <TextBlock Text="📄" IsVisible="{Binding !IsFolder}" />
                                        <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    </StackPanel>

                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Import Folder" Command="{Binding AddUserScriptFolderCommand}" Foreground="White" />
                        <Button Content="Remove Selected" Command="{Binding RemoveScriptsCommand}" Foreground="White" />
                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="Cancel" Command="{Binding GoToHomeCommand}" 
                            Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" />
                    <Button Content="Create Template" Command="{Binding CreateTemplateCommand}" 
                            Foreground="White"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>