<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:models="clr-namespace:BootStrapper.Core.Models;assembly=BootStrapper.Core"
             xmlns:vm="clr-namespace:BootStrapper.ViewModels.Templates"
             x:Class="BootStrapper.Views.Templates.TemplateInfoView"
             x:DataType="vm:TemplateInfoViewModel">

    <Design.DataContext>
        <vm:TemplateInfoViewModel/>
    </Design.DataContext>

    <Grid Background="#171717" RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#37345D"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Spacing="8">

                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Foreground="White"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">

                            <Border Background="#626262" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="{Binding Category}" Foreground="White"/>
                            </Border>

                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="10">

                    <Border Background="#626262" MaxWidth="70" Padding="10,5" CornerRadius="6">
                        <TextBlock Text="{Binding Version}" Foreground="White"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                         <Button Content="Open Template Folder" Command="{Binding OpenTemplateFolderCommand}" Foreground="White"/>
                         <Button Content="Delete" Command="{Binding DeleteTemplateCommand}" Background="#8B2E2E" Foreground="White"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Manifest + Template Structure + File Preview 1 por 2 -->
        <Grid Grid.Row="1" ColumnDefinitions="350,*" ColumnSpacing="20">

            <!-- MANIFEST INFO -->
            <Border Grid.Column="0" Background="#37345D" CornerRadius="10" Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Spacing="14">

                        <TextBlock Text="Manifest Info"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Name" Foreground="White"/>
                            <TextBox Text="{Binding Name}" PlaceholderText="Template Name"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Description" Foreground="White"/>
                            <TextBox AcceptsReturn="True"
                                     Height="90"
                                     TextWrapping="Wrap"
                                     Text="{Binding Description}" PlaceholderText="Insert the Template Description"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Unity Version" Foreground="White"/>
                            <TextBox Text="{Binding UnityVersion}" PlaceholderText="Working Unity Version"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Max Unity Version" Foreground="White"/>
                            <TextBox Text="{Binding MaxUnityVersion}" PlaceholderText="Author"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Tags" Foreground="White" />

                            <ItemsControl ItemsSource="{Binding AddedTags}" Classes="horizontal">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox Text="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        <Button Width="80" Height="30" Margin="0,0,6,6" Content="Add">
                            <Button.Flyout>

                                <Flyout Placement="BottomEdgeAlignedLeft">

                                    <StackPanel Width="240" Margin="6" Spacing="6">

                                        <TextBox Watermark="Search tag..."/>

                                        <ScrollViewer MaxHeight="220">

                                            <ItemsControl ItemsSource="{Binding Tags}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <Button
                                                        HorizontalContentAlignment="Left"
                                                        Content="{Binding .}"
                                                        Command="{Binding $parent[UserControl].DataContext.AddTagCommand}"
                                                        CommandParameter="{Binding .}"/>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </ScrollViewer>

                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Author" Foreground="White"/>
                            <TextBox Text="{Binding Author}" PlaceholderText="Author"/>
                        </StackPanel>

                        <Button Content="Open Template Folder" Command="{Binding OpenTemplateFolderCommand}" Margin="0,10,0,0" Foreground="White"/>
                        <Button Content="Update Template" 
                                Command="{Binding UpdateTemplateCommand}"
                                Margin="0,40,0,0" 
                                HorizontalAlignment="Center" Foreground="White"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- STRUCTURE + EDITOR -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  RowSpacing="20">

                <!-- STRUCTURE -->
                <Border Grid.Row="0"
                        Background="#37345D"
                        CornerRadius="10"
                        Padding="20">

                    <StackPanel Spacing="12">

                        <TextBlock Text="Template Structure"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <Border Background="#2B2D3D" Padding="14" CornerRadius="8">
                            <TreeView ItemsSource="{Binding TemplateScripts}" Foreground="White" SelectedItem="{Binding SelectedNode}">
                                <TreeView.ItemTemplate>

                                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:TemplateNode">

                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📁" IsVisible="{Binding IsFolder}" />
                                            <TextBlock Text="📄" IsVisible="{Binding !IsFolder}" />
                                            <TextBlock Text="{Binding Name}" Foreground="White"/>
                                        </StackPanel>

                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Add" Command="{Binding AddScriptsCommand}" Foreground="White"/>
                            <Button Content="Remove" Command="{Binding RemoveScriptCommand}" CommandParameter="{Binding SelectedNode}" Foreground="White"/>
                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- FILE PREVIEW -->
                <Border Grid.Row="1"
                        Background="#37345D"
                        CornerRadius="10"
                        Padding="20">

                    <StackPanel Spacing="12">

                        <TextBlock Text="File Preview"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBox AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 Background="#2B2D3D"
                                 Foreground="White"
                                 Height="300"
                                 Text="using UnityEngine;&#x0a;&#x0a;public class Class1 : MonoBehaviour&#x0a;{&#x0a;&#x0a;}" />

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</UserControl>