<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BootStrapper.App"
             xmlns:local="using:BootStrapper"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/horizontal.axaml"/>
    </Application.Styles>

    <Application.Resources>
        
    </Application.Resources>
</Application>